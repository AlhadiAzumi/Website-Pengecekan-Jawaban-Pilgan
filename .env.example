# Contoh environment variable untuk deploy.
# Salin menjadi .env saat menjalankan lokal, atau isi di dashboard Render.

# Wajib di produksi: string acak panjang.
SECRET_KEY=ganti-dengan-string-acak-panjang

# Lokasi data. Di Render persistent disk di-mount ke /var/data.
PILGAN_DATA_DIR=/var/data

# Opsional: aktifkan basic auth jika keduanya diisi.
APP_USERNAME=admin
APP_PASSWORD=ganti-password-kuat

# Opsional: gunakan PostgreSQL. Kosongkan untuk SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Opsional: performa Gunicorn.
WEB_CONCURRENCY=1
WEB_THREADS=4
GUNICORN_TIMEOUT=300
